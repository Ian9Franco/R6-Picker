  "tacticalGuidelines": {
    "attack": {
      "do": [
        "Jugar Kali o Thermite antes que Ace si falta abrir pared. Ace solo si aporta ventaja concreta a distancia.",
        "Conservar al menos un dron, dejar el desactivador si va a pelear, y transformarse en segundo entry inmediatamente tras abrir.",
        "Dejar el soporte si el equipo no consigue kills y usar flex: Ash, Ram, Iana, Brava, Zofia, Ying, Deimos, Flores.",
        "Entrar siempre con dron y convertir info en acción inmediata (agresividad informada)."
      ],
      "avoid": [
        "Quedarse automáticamente con hard support si Chango ya lo cubre.",
        "Quedarse atrás después de gastar utilidad.",
        "Cazar una kill durante noventa segundos (cortar la persecución si ya obtuvo control)."
      ]
    },
    "defense": {
      "do": [
        "Control de posiciones y lectura del ataque (Valkyrie, Fenrir, Vigil, Mozzie, Pulse, Jäger).",
        "Tomar la responsabilidad que falta y, cuando está cumplida, generar la ventaja activa.",
        "Consumir tiempo. Tener ruta de regreso y volver a sitio cuando queden 60-45 segundos."
      ],
      "avoid": [
        "Perseguir una kill a costa de la ejecución de la ronda (aislarse).",
        "Repeekear si el equipo ya tiene ventaja.",
        "Cubrir soporte si Chango ya lo tomó; salir inmediatamente hacia roaming/intel."
      ]
    },
    "general": {
      "do": [
        "Adaptar el rol según la composición, no quedar clavado de soporte."
      ],
      "avoid": [
        "Duplicar utilidad estructural sin necesidad."
      ]
    }
  },
